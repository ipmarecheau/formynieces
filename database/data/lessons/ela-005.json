            },
            {
                "type": "key",
                "content": "A prefix goes in FRONT of a root word and changes its meaning. 'un-' means 'not', so 'unhappy' means 'not happy'.",
                "cognition": "knowing"
            },
            {
                "type": "example",
                "content": "Adding the prefix un-.",
                "steps": [
                    "Start with the root word: 'kind'.",
                    "Add the prefix un- to the front: 'unkind'.",
                    "un- means 'not', so 'unkind' means 'not kind'."
                ],
                "cognition": "knowing"
            },
            {
