            {
                "type": "check",
                "cognition": "reasoning",
                "question": "The sentence 'Yesterday she walk to school' does not sound right. What is wrong, and how do you know?",
                "options": [
                    "It should be 'walked' — 'yesterday' shows it happened in the past",
                    "It is correct",
                    "It should be 'walks'"
                ],
                "answer": 0,
                "explain": "'Yesterday' is a signal that the action already happened, so the verb must be in the past tense: 'walked'. The time word and the verb tense have to match.",
                "rule": "Match the verb tense to when the action happens; past actions use the past tense.",
                "principle": "Time words and verb tense must agree.",
                "canonical_solution": [
                    "'Yesterday' means in the past",
                    "The verb must be past tense",
                    "Past of 'walk' is 'walked'",
                    "So: 'Yesterday she walked to school'"
