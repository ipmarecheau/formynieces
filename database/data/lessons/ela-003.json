        ],
        "canonical_examples_source": "Language rules self-verified; format ref: bank uk-ks2-2024-gps (KS2 GPS).",
        "blocks": [
            {
                "type": "text",
                "content": "Many words end in a silent e — you write it but don't say it, like in 'make'. When you add an ending, that e sometimes has to go.",
                "cognition": "knowing"
            },
            {
                "type": "key",
                "content": "When a word ends in a silent e, drop the e before adding an ending that starts with a vowel (-ing, -ed, -able).",
                "cognition": "knowing"
            },
            {
                "type": "example",
                "content": "Adding -ing to 'make'.",
                "steps": [
                    "'make' ends in a silent e.",
                    "The ending -ing starts with a vowel.",
                    "Drop the e and add -ing: 'making'."
                ],
                "cognition": "knowing"
            },
            {
                "type": "fillblank",
                "prompt": "ride + ing = ___",
                "answer": "riding",
                "explain": "'ride' ends in silent e and -ing starts with a vowel, so drop the e: riding.",
                "rule": "When a word ends in silent e, drop the e before an ending that starts with a vowel.",
                "practiceItems": [
                    {
                        "prompt": "make + ing",
                        "answer": "making"
                    },
                    {
                        "prompt": "hope + ing",
                        "answer": "hoping"
                    },
                    {
                        "prompt": "bake + ed",
                        "answer": "baked"
                    },
                    {
                        "prompt": "drive + ing",
                        "answer": "driving"
                    },
                    {
                        "prompt": "use + able",
                        "answer": "usable"
                    }
                ],
                "cognition": "applying"
            },
            {
                "type": "key",
                "content": "But KEEP the silent e when the ending starts with a consonant, like -ful or -ly.",
                "cognition": "knowing"
            },
            {
                "type": "check",
                "question": "Which spelling is correct?",
                "options": [
                    "hopful",
                    "hopeful",
                    "hopefull"
                ],
                "answer": 1,
                "explain": "-ful starts with a consonant, so keep the silent e: hopeful.",
                "rule": "Keep the silent e when the ending starts with a consonant, like -ful or -ly.",
                "practiceItems": [
                    {
                        "prompt": "hope + ful",
                        "answer": "hopeful"
                    },
                    {
                        "prompt": "nice + ly",
                        "answer": "nicely"
                    },
                    {
                        "prompt": "care + ful",
                        "answer": "careful"
                    },
                    {
                        "prompt": "safe + ly",
                        "answer": "safely"
                    }
                ],
                "cognition": "applying"
            },
            {
                "type": "text",
                "content": "Remember: a vowel ending pushes the e out; a consonant ending lets it stay. Let's practise!",
                "cognition": "knowing"
            }
        ]
    }
]
