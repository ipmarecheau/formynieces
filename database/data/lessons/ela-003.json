        "module": "ELA-003",
        "title": "Dropping the silent -e before adding an ending",
        "is_published": true,
        "objectives_direct": [
            "E-SPE-54"
        ],
        "objectives_indirect": [
            "E-SPE-52",
            "E-SPE-53",
