        "blocks": [
            {
                "type": "text",
                "content": "The subject and the verb of a sentence must agree — they have to match. Get this right and your sentences sound correct every time. Quick words: subject means the person or thing doing the action in a sentence.",
                "cognition": "knowing"
            },
            {
                "type": "key",
                "content": "One person or thing (a singular subject) takes a verb ending in s: the dog barks.",
                "cognition": "knowing"
            },
            {
                "type": "example",
                "content": "Matching a singular subject.",
                "steps": [
                    "Subject: 'the bird' (just one).",
                    "A singular subject needs the verb with s: 'sings'.",
                    "The bird sings."
                ],
                "cognition": "knowing"
            },
            {
                "type": "fillblank",
                "prompt": "The cat ___ very fast. (run)",
                "answer": "runs",
                "explain": "'The cat' is singular, so the verb takes an s: runs.",
                "rule": "A singular subject (one person or thing) takes a verb ending in s.",
                "practiceItems": [
                    {
                        "prompt": "'She ___ every day.' (play)",
                        "answer": "plays"
                    },
                    {
                        "prompt": "'He ___ his lunch.' (eat)",
                        "answer": "eats"
                    },
                    {
                        "prompt": "'The baby ___.' (cry)",
                        "answer": "cries"
                    },
                    {
                        "prompt": "'The dog ___.' (bark)",
                        "answer": "barks"
                    }
                ],
                "cognition": "applying"
            },
            {
                "type": "key",
                "content": "More than one (a plural subject), and the words I and you, take the verb WITHOUT s: the dogs bark.",
