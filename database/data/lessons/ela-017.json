        "blocks": [
            {
                "type": "text",
                "content": "When we compare things, adjectives change their ending. Learn the two endings and you can compare anything clearly. Quick words: adjective means a word that tells us what something is like, such as big or tall. superlative means the form used to show the highest amount of a quality among all things.",
                "cognition": "knowing"
            },
            {
                "type": "key",
                "content": "Add -er to an adjective to compare TWO things: a giraffe is taller than a horse.",
                "cognition": "knowing"
            },
            {
                "type": "example",
                "content": "Comparing two things.",
                "steps": [
                    "Adjective: 'tall'.",
                    "To compare two, add -er: 'taller'.",
                    "A giraffe is taller than a horse."
                ],
                "cognition": "knowing"
            },
            {
                "type": "fillblank",
                "prompt": "Compare two: A truck is ___ than a car. (big)",
                "answer": "bigger",
                "explain": "Add -er to compare two things; 'big' doubles the g: bigger.",
                "rule": "Add -er to an adjective to compare two things (double a final consonant after a short vowel).",
                "practiceItems": [
                    {
                        "prompt": "comparative of 'tall'",
                        "answer": "taller"
                    },
                    {
                        "prompt": "comparative of 'fast'",
                        "answer": "faster"
                    },
                    {
                        "prompt": "comparative of 'small'",
                        "answer": "smaller"
                    },
                    {
                        "prompt": "comparative of 'big' (double the g)",
                        "answer": "bigger"
                    }
                ],
                "cognition": "applying"
            },
            {
                "type": "key",
                "content": "Add -est to show the most of ALL: the tallest tree in the park.",
                "cognition": "knowing"
            },
            {
                "type": "fillblank",
                "prompt": "The most of all: That is the ___ mountain of them all. (high)",
                "answer": "highest",
                "explain": "Add -est to show the most of all: highest.",
                "rule": "Add -est to an adjective to show the most of all.",
                "practiceItems": [
                    {
                        "prompt": "superlative of 'tall'",
                        "answer": "tallest"
                    },
                    {
                        "prompt": "superlative of 'fast'",
                        "answer": "fastest"
                    },
                    {
                        "prompt": "superlative of 'small'",
                        "answer": "smallest"
                    },
                    {
                        "prompt": "superlative of 'big' (double the g)",
                        "answer": "biggest"
                    }
                ],
                "cognition": "applying"
            },
            {
                "type": "check",
                "cognition": "reasoning",
                "question": "You compare THREE mangoes by size. Do you say one is 'bigger' or the 'biggest', and why?",
                "options": [
                    "biggest — the superlative is used for three or more",
                    "bigger — it works for any number",
                    "big — no ending is needed"
                ],
                "answer": 0,
                "explain": "'bigger' (the comparative) compares just two things. 'biggest' (the superlative) is for three or more. With three mangoes, you pick the 'biggest'.",
                "rule": "Use the comparative (-er) for two; the superlative (-est) for three or more.",
                "principle": "The form of an adjective depends on how many things are compared.",
                "canonical_solution": [
                    "Comparative 'bigger' compares two",
                    "Superlative 'biggest' compares three or more",
