        "blocks": [
            {
                "type": "text",
                "content": "Modal verbs are helping words that come before another verb. They show whether you are able to, allowed to, or likely to do something.",
                "cognition": "knowing"
            },
            {
                "type": "key",
                "content": "A modal comes before a main verb to show ability (can), permission (may), advice (should) or possibility (might).",
                "cognition": "knowing"
            },
            {
                "type": "example",
                "content": "Reading a modal.",
                "steps": [
                    "'I can swim' — 'can' shows ability.",
                    "'May I go?' — 'may' asks for permission.",
                    "The modal always sits just before the main verb."
                ],
                "cognition": "knowing"
            },
            {
                "type": "check",
                "question": "Which sentence politely asks for permission?",
                "options": [
                    "May I leave the room?",
                    "Might I leave the room?",
                    "Would I leave the room?"
                ],
                "answer": 0,
                "explain": "'may' is the modal that asks for or gives permission: May I leave the room?",
                "rule": "The modal 'may' asks for or gives permission.",
                "practiceItems": [
                    {
                        "prompt": "modal for asking permission: ___ I come in?",
                        "answer": "may"
                    },
                    {
                        "prompt": "modal for ability: I ___ swim",
                        "answer": "can"
                    },
                    {
                        "prompt": "modal for advice: you ___ rest",
                        "answer": "should"
                    },
                    {
                        "prompt": "modal for possibility: it ___ rain later",
                        "answer": "might"
                    }
                ],
                "cognition": "applying"
            },
            {
                "type": "key",
                "content": "Use 'should' to give advice, and 'could' for a possibility or a polite request.",
                "cognition": "knowing"
            },
            {
                "type": "fillblank",
                "prompt": "Give advice: You ___ study for your test.",
                "answer": "should",
                "explain": "'should' gives advice about the right thing to do: You should study.",
                "rule": "Use 'should' to give advice about the right thing to do.",
                "practiceItems": [
                    {
                        "prompt": "advice modal: you ___ eat well",
                        "answer": "should"
                    },
                    {
                        "prompt": "advice modal: we ___ help others",
                        "answer": "should"
                    },
                    {
                        "prompt": "polite request modal: ___ you help me, please?",
                        "answer": "could"
                    },
                    {
                        "prompt": "possibility modal: we ___ win if we try",
                        "answer": "might"
                    }
                ],
                "cognition": "applying"
            },
            {
                "type": "check",
                "cognition": "reasoning",
                "question": "'You ___ wear a helmet when you ride.' For firm advice, which modal fits best: should, might, or can?",
                "options": [
                    "should — it gives advice or a sense of duty",
                    "might — it means maybe",
                    "can — it means being able to"
                ],
                "answer": 0,
                "explain": "Modals change how strong or certain a sentence is. 'should' gives advice or duty, 'might' shows only a possibility, and 'can' shows ability. For firm safety advice, 'should' fits: 'You should wear a helmet.'",
                "rule": "'should' = advice/duty, 'might' = possibility, 'can' = ability.",
                "principle": "Different modals carry different degrees of certainty or obligation.",
                "canonical_solution": [
                    "The sentence gives safety advice",
                    "'should' expresses advice/duty",
                    "'might' is only maybe; 'can' is ability",
                    "So 'should' fits best"
                ],
                "rubric": [
                    {
                        "dimension": "method",
                        "look_for": "decides what the sentence needs (advice)"
